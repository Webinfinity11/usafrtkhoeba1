---
// Line icons (24×24, stroke) - one per audience
const groups = [
  {
    title: "საწარმოები და ქარხნები",
    text: "ხმაურიანი და ვიბრაციის გამომწვევი დანადგარების მქონე ობიექტები, სადაც აუცილებელია შრომის უსაფრთხოების კონტროლი.",
    icon: '<path d="M3 21V10l5 3V10l5 3V10l5 3V4h3v17Z"/><path d="M7 17h2M12 17h2M17 17h1"/>',
  },
  {
    title: "კომერციული ობიექტები",
    text: "ოფისები, სავაჭრო ცენტრები, რესტორნები, სასტუმროები და გასართობი სივრცეები.",
    icon: '<path d="M4 9h16l-1.5-5h-13Z"/><path d="M5 9v12h14V9"/><path d="M10 21v-6h4v6"/>',
  },
  {
    title: "საცხოვრებელი შენობები",
    text: "ბინათმესაკუთრეთა ამხანაგობები, დეველოპერები და მაცხოვრებლები, რომლებსაც ხმაურის ან ვიბრაციის ობიექტური შეფასება სჭირდებათ.",
    icon: '<path d="M6 21V3h12v18"/><path d="M3 21h18"/><path d="M9.5 7h1M13.5 7h1M9.5 11h1M13.5 11h1M9.5 15h1M13.5 15h1"/>',
  },
  {
    title: "სამშენებლო კომპანიები",
    text: "ობიექტის ექსპლუატაციაში მიღებამდე ან სამუშაოების მიმდინარეობისას.",
    icon: '<path d="M4 21V5h9"/><path d="M4 5 8 2h12v3h-7"/><path d="M17 5v5"/><path d="M15 10h4v3h-4z"/><path d="M2 21h8"/>',
  },
  {
    title: "ორგანიზაციები, რომლებიც ემზადებიან ინსპექტირებისთვის",
    text: "როცა საჭიროა ოფიციალური დოკუმენტი, რომ ობიექტი ნორმებს შეესაბამება.",
    icon: '<path d="M9 4H6a1 1 0 0 0-1 1v15a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-3"/><path d="M9 3h6v3H9z"/><path d="m9 13 2 2 4-4"/>',
  },
];
---

<section id="audience" class="section container">
  <div class="split">
    <div class="side">
      <h2>ვისთვისაა</h2>
    </div>
    <ul class="list">
      {groups.map((g) => (
        <li>
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={g.icon} />
          </span>
          <div>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: 1fr 1.6fr; gap: 32px 80px; align-items: start; }
  .side { position: sticky; top: 120px; }

  .list { list-style: none; }
  li { display: grid; grid-template-columns: 52px 1fr; gap: 22px; padding: 26px 0; }
  li + li { border-top: 1px solid var(--line); }
  li:first-child { padding-top: 0; }
  .ic {
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: var(--gold-soft); color: var(--gold-deep);
    transition: background 0.3s, color 0.3s;
  }
  @media (hover: hover) and (pointer: fine) { li:hover .ic { background: var(--gold); color: var(--navy); } }
  h3 { font-size: 1.08rem; color: var(--navy); line-height: 1.4; margin: 3px 0 6px; text-wrap: balance; }
  p { color: var(--muted); max-width: 44em; text-wrap: pretty; }

  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
    .side { position: static; }
    li { grid-template-columns: 44px 1fr; gap: 16px; padding: 22px 0; }
    .ic { width: 44px; height: 44px; }
  }
</style>
